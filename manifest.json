{
  "manifest_version": 3,
  "name": "Trustlock Message Guard",
  "version": "0.3.0",
  "description": "Screen unusual messages and right-click images for deepfake and social engineering reviews.",
  "permissions": ["activeTab", "scripting", "storage", "notifications", "contextMenus"],
  "optional_host_permissions": [
    "https://mail.google.com/*",
    "https://web.telegram.org/*",
    "https://web.whatsapp.com/*",
    "https://discord.com/*",
    "http://127.0.0.1/*",
    "http://localhost/*"
  ],
  "background": {
    "service_worker": "service-worker.js",
    "type": "module"
  },
  "action": {
    "default_title": "Trustlock Message Guard",
    "default_popup": "popup.html"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
